---
import {
  CATEGORIES,
  type Category,
  type Deviation,
} from "../../../../parity/deviations.ts";

interface Props {
  deviations: Deviation[];
  notes: string[];
}

const { deviations, notes } = Astro.props;

/** Deviations by category, then by the reason they share, in category order. */
const groups = (Object.keys(CATEGORIES) as Category[])
  .map((category) => {
    const byReason = new Map<string, Deviation[]>();
    for (const d of deviations.filter((d) => d.category === category))
      byReason.set(d.reason, [...(byReason.get(d.reason) ?? []), d]);
    return { category, reasons: [...byReason] };
  })
  .filter((group) => group.reasons.length > 0);
---

<h2 class="section-title">Deviations</h2>
{
  groups.length > 0 ? (
    <>
      <p class="text-base">
        Where this form differs from the Grants.gov DAT and XSD, or from its own plan.
        Each one is checked by the parity tests, which fail if it changes.
      </p>
      {groups.map(({ category, reasons }) => (
        <section class="deviation-group">
          <h3 class="deviation-group__title">
            <span class={`deviation-badge deviation-badge--${category}`}>
              {CATEGORIES[category].label}
            </span>
            <span class="deviation-group__description">
              {CATEGORIES[category].description}
            </span>
          </h3>
          {reasons.map(([reason, rows]) => (
            <div class="deviation">
              <p class="deviation__reason">{reason}</p>
              <ul class="deviation__fields">
                {rows.map((row) => (
                  <li>
                    <strong>{row.field}</strong>
                    {row.path !== row.field && <code class="deviation__path">{row.path}</code>}
                    <span class="deviation__comparison">{row.comparison}</span>
                    {row.difference}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))}
    </>
  ) : (
    <p class="text-base">No recorded deviations.</p>
  )
}

{
  notes.length > 0 && (
    <>
      <h2 class="section-title margin-top-4">Notes</h2>
      <p class="text-base">Context from planning. Unlike deviations, notes are not checked.</p>
      <ul class="deviation-notes">
        {notes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </>
  )
}
