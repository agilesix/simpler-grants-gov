---
import type { FormNode } from "../../content.config";
import { countFields } from "../../lib/planTree";
import FieldRow from "./FieldRow.astro";

interface Props {
  nodes: FormNode[];
}

const { nodes } = Astro.props;
---

{nodes.map((node) =>
  node.kind === "section" ? (
    <details class="field-section" open>
      <summary>
        {node.label}
        <span class="section-count">{countFields(node.children)} fields</span>
      </summary>
      <div class="field-section__body">
        <Astro.self nodes={node.children} />
      </div>
    </details>
  ) : (
    <FieldRow field={node} />
  ),
)}
