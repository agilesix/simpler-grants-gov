            "$ref": "#/$defs/monetary_amount"
          }
        },
        "description": "Federal funds needed for the balance of the project, by year.",
        "title": "Federal Fund Estimates"
      },
      "direct_charges_explanation": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50,
        "description": "Explain direct-charge amounts that need additional context.",
