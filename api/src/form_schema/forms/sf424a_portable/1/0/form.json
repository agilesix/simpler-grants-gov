      },
      "activity_title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "description": "Identify the grant program, function, or activity represented by a budget row.",
        "title": "Grant program, function, or activity"
      },
      "activity_assistance_listing_number": {
        "type": "string",
        "minLength": 1,
        "maxLength": 15,
        "description": "Enter the Assistance Listing number associated with this budget activity, when applicable.",
        "title": "Assistance Listing number"
