      "summary": {
        "type": "object",
        "properties": {
          "federal_estimated_unobligated_amount": {
            "allOf": [
              {
                "$ref": "#/$defs/monetary_amount"
              }
            ],
            "title": "Estimated unobligated federal funds",
            "description": "Federal funds authorized under an award that have not yet been obligated. Enter an amount only when the application instructions require it."
          },
          "non_federal_estimated_unobligated_amount": {
            "allOf": [
              {
                "$ref": "#/$defs/monetary_amount"
              }
            ],
            "title": "Estimated unobligated non-federal funds",
            "description": "Non-federal funds required under an award that have not yet been obligated or used. Enter an amount only when the application instructions require it."
          },
          "federal_new_or_revised_amount": {
            "allOf": [
              {
                "$ref": "#/$defs/monetary_amount"
              }
            ],
            "title": "New or revised federal budget",
            "description": "Enter federal funds needed for the upcoming period. For a supplemental application, enter the additional amount requested. For a change, enter the increase or decrease."
          },
          "non_federal_new_or_revised_amount": {
            "allOf": [
              {
                "$ref": "#/$defs/monetary_amount"
              }
            ],
            "title": "New or revised non-federal budget",
            "description": "Enter the non-federal share for the upcoming period. For a supplemental application, enter the additional contribution. For a change, enter the increase or decrease."
          },
          "total_amount": {
            "allOf": [
              {
                "$ref": "#/$defs/monetary_amount"
              }
            ],
            "title": "Total",
            "description": "Enter the total budgeted amount for this row. This value is not calculated automatically."
          }
        },
        "description": "Estimated unobligated and new or revised funds, federal and non-federal.",
        "title": "Budget Summary"
      },
      "monetary_amount": {
        "type": "string",
        "minLength": 1,
        "maxLength": 14,
        "pattern": "^(-)?\\d*([.]\\d{2})?$",
        "description": "A dollar amount. Held as a string rather than a number so that a cent is never lost to\nbinary floating point."
      },
      "categories": {
        "type": "object",
        "properties": {
