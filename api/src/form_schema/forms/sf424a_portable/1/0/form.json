          "construction_amount": {
            "$ref": "#/$defs/monetary_amount"
          },
          "other_amount": {
            "$ref": "#/$defs/monetary_amount"
          },
          "total_direct_charge_amount": {
            "$ref": "#/$defs/monetary_amount"
          },
          "total_indirect_charge_amount": {
            "$ref": "#/$defs/monetary_amount"
          },
          "total_amount": {
