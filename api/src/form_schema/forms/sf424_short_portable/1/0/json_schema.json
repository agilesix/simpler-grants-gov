{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agency_name": {
      "allOf": [
        {
          "$ref": "#/$defs/agency_name"
        }
      ],
      "description": "Pre-populated from the Application cover sheet.",
      "title": "Name of Federal Agency"
    },
    "assistance_listing_number": {
      "allOf": [
        {
          "$ref": "#/$defs/assistance_listing_number"
        }
      ],
      "description": "Pre-populated from the Application cover sheet.",
      "title": "Assistance Listing Number"
    },
    "assistance_listing_program_title": {
      "allOf": [
        {
          "$ref": "#/$defs/assistance_listing_title"
        }
      ],
      "description": "Pre-populated from the Application cover sheet.",
      "title": "Assistance Listing Title"
    },
    "date_received": {
      "allOf": [
        {
          "$ref": "#/$defs/date_received"
        }
      ],
      "description": "Completed by Grants.gov upon submission.",
      "title": "Date Received",
      "readOnly": true
    },
    "funding_opportunity_number": {
      "allOf": [
        {
          "$ref": "#/$defs/number"
        }
      ],
      "description": "Pre-populated from the Application cover sheet.",
      "title": "Funding Opportunity Number"
    },
    "funding_opportunity_title": {
      "allOf": [
        {
          "$ref": "#/$defs/title"
        }
      ],
      "description": "Pre-populated from the Application cover sheet.",
      "title": "Funding Opportunity Title"
    },
    "organization_name": {
      "allOf": [
        {
          "$ref": "#/$defs/legal_name"
        }
      ],
      "description": "Enter the legal name of applicant that will undertake the assistance activity. This is the name that the organization has registered with the System for Award Management (SAM.gov). Information on registering with SAM may be obtained by visiting the Grants.gov website.",
      "title": "Legal Name"
    },
    "applicant": {
      "allOf": [
        {
          "$ref": "#/$defs/address"
        }
      ],
      "description": "Enter the address of the applicant.",
      "title": "Address"
    },
    "applicant_web_address": {
      "allOf": [
        {
          "$ref": "#/$defs/website"
        }
      ],
      "description": "Enter the applicant's web address, if applicable.",
      "title": "Web Address",
      "maxLength": 250
    },
    "applicant_type_code": {
      "allOf": [
        {
          "$ref": "#/$defs/applicant_type"
        }
      ],
      "description": "Select a minimum of one applicant type or select up to three applicant types in accordance with agency instructions. If “Other” is selected, then specify Other Type of Applicant in text box.",
      "title": "Type of Applicant"
    },
    "applicant_type_other_specify": {
      "allOf": [
        {
          "$ref": "#/$defs/applicant_type_other"
        }
      ],
      "description": "Enter the applicant type here if you selected \"Other (specify)\" for Type of applicant.",
      "title": "Type of Applicant Other Explanation"
    },
    "employer_taxpayer_identification_number": {
      "allOf": [
        {
          "$ref": "#/$defs/ein"
        }
      ],
      "description": "Enter either TIN or EIN as assigned by the Internal Revenue Service.  If your organization is not in the US, enter 44-4444444.",
      "title": "EIN/TIN"
    },
    "sam_uei": {
      "allOf": [
        {
          "$ref": "#/$defs/uei"
        }
      ],
      "description": "UEI of the applicant organization. This field is pre-populated from the Application cover sheet.",
      "title": "SAM UEI"
    },
    "congressional_district_applicant": {
      "allOf": [
        {
          "$ref": "#/$defs/congressional_district"
        }
      ],
      "description": "Congressional District of Applicant is required: Enter the Congressional District in the format: 2 character State Abbreviation - 3 character District Number. Examples: CA-005 for California's 5th District, CA-012 for California's 12th District, NC-103 for North Carolina's 103rd District. If outside the U.S., enter 00-000.",
      "title": "Congressional District of Applicant"
    },
    "project_title": {
      "allOf": [
        {
          "$ref": "#/$defs/title_2"
        }
      ],
      "description": "Enter a brief, descriptive title of the project.",
      "title": "Project Title",
      "maxLength": 200
    },
    "project_description": {
      "allOf": [
        {
          "$ref": "#/$defs/description"
        }
      ],
      "description": "Enter a brief description of the project.",
      "title": "Project Description"
    },
    "project_start_date": {
      "allOf": [
        {
          "$ref": "#/$defs/start_date"
        }
      ],
      "description": "Enter the date in the format MM/DD/YYYY.",
      "title": "Project Start Date"
    },
    "project_end_date": {
      "allOf": [
        {
          "$ref": "#/$defs/end_date"
        }
      ],
      "description": "Enter the date in the format MM/DD/YYYY.",
      "title": "Project End Date"
    },
    "project_director": {
      "allOf": [
        {
          "$ref": "#/$defs/Sf424ShortContact"
        }
      ],
      "title": "Project Director"
    },
    "same_as_project_director": {
      "type": "boolean",
      "title": "Same as Project Director (if checked, fill in information same as Project Director above)"
    },
    "contact_person": {
      "allOf": [
        {
          "$ref": "#/$defs/Sf424ShortContact"
        }
      ],
      "title": "Primary Contact/Grants Administrator"
    },
    "application_certification": {
      "type": "boolean",
      "description": "** The list of certifications and assurances, or an internet site where you may obtain this list, is contained in the announcement or agency specific instructions. By signing this application, I certify (1) to the statements contained in the list of certifications and (2) that the statements herein are true, complete and accurate to the best of my knowledge. I also provide the required assurances and agree to comply with any resulting terms if I accept an award. I am aware that any false, fictitious, or fraudulent statements or claims may subject me to criminal, civil, or administrative penalties. (U.S. Code, Title 18, Section 1001)",
      "title": "** I Agree"
    },
    "authorized_representative": {
      "allOf": [
        {
          "$ref": "#/$defs/name"
        }
      ],
      "description": "Enter the name of the authorized representative.",
      "title": "Authorized Representative",
      "required": [
        "first_name",
        "last_name"
      ]
    },
    "authorized_representative_title": {
      "allOf": [
        {
          "$ref": "#/$defs/title_3"
        }
      ],
      "description": "Enter the position title.",
      "title": "Title"
    },
    "authorized_representative_email": {
      "allOf": [
        {
          "$ref": "#/$defs/email"
        }
      ],
      "description": "Enter a valid email Address.",
      "title": "Email"
    },
    "authorized_representative_phone_number": {
      "allOf": [
        {
          "$ref": "#/$defs/phone"
        }
      ],
      "description": "Enter the daytime Telephone Number.",
      "title": "Telephone Number"
    },
    "authorized_representative_fax": {
      "allOf": [
        {
          "$ref": "#/$defs/fax"
        }
      ],
      "description": "Enter the Fax Number.",
      "title": "Fax Number"
    },
    "aor_signature": {
      "allOf": [
        {
          "$ref": "#/$defs/signature"
        }
      ],
      "description": "Completed by Grants.gov upon submission.",
      "title": "Signature of Authorized Representative",
      "readOnly": true
    },
    "authorized_representative_date_signed": {
      "allOf": [
        {
          "$ref": "#/$defs/date_signed"
        }
      ],
      "description": "Completed by Grants.gov upon submission.",
      "title": "Date Signed",
      "readOnly": true
    }
  },
  "required": [
    "agency_name",
    "funding_opportunity_number",
    "funding_opportunity_title",
    "organization_name",
    "applicant",
    "applicant_type_code",
    "employer_taxpayer_identification_number",
    "sam_uei",
    "congressional_district_applicant",
    "project_title",
    "project_description",
    "project_start_date",
    "project_end_date",
    "project_director",
    "contact_person",
    "application_certification",
    "authorized_representative",
    "authorized_representative_title",
    "authorized_representative_email",
    "authorized_representative_phone_number"
  ],
  "description": "Application for Federal Domestic Assistance-Short Organizational (SF-424)",
  "allOf": [
    {
      "if": {
        "properties": {
          "applicant_type_code": {
            "contains": {
              "const": "X: Other (specify)"
            }
          }
        },
        "required": [
          "applicant_type_code"
        ]
      },
      "then": {
        "required": [
          "applicant_type_other_specify"
        ]
      }
    }
  ],
  "$defs": {
    "Sf424ShortContact": {
      "type": "object",
      "properties": {
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/contact_title"
            }
          ],
          "description": "Enter the position title.",
          "title": "Title"
        }
      },
      "required": [
        "title"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/details"
        }
      ],
      "description": "A person to contact about this application.",
      "title": "Contact"
    },
    "agency_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "The awarding federal agency.",
      "title": "Agency Name"
    },
    "assistance_listing_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15,
      "description": "The Assistance Listing (formerly CFDA) number.",
      "title": "Assistance Listing Number"
    },
    "assistance_listing_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "The Assistance Listing program title.",
      "title": "Assistance Listing Title"
    },
    "date_received": {
      "type": "string",
      "format": "date",
      "description": "Completed by Grants.gov upon submission.",
      "title": "Date Received"
    },
    "number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "The funding opportunity number.",
      "title": "Opportunity Number"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "The funding opportunity title.",
      "title": "Opportunity title"
    },
    "legal_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "Enter the legal name of the applicant that will undertake the assistance activity.",
      "title": "Legal Name"
    },
    "address": {
      "type": "object",
      "properties": {},
      "allOf": [
        {
          "$ref": "#/$defs/address_2"
        },
        {
          "if": {
            "properties": {
              "country": {
                "const": "USA: UNITED STATES"
              }
            },
            "required": [
              "country"
            ]
          },
          "then": {
            "required": [
              "zip_code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "country": {
                "const": "USA: UNITED STATES"
              }
            },
            "required": [
              "country"
            ]
          },
          "then": {
            "required": [
              "state"
            ]
          }
        }
      ],
      "description": "Enter the address of the applicant.",
      "title": "Address",
      "required": [
        "street1",
        "city",
        "country"
      ]
    },
    "address_2": {
      "type": "object",
      "properties": {
        "street1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 55,
          "description": "Enter the first line of the Street Address.",
          "title": "Street 1"
        },
        "street2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 55,
          "description": "Enter the second line of the Street Address.",
          "title": "Street 2"
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 35,
          "description": "Enter the city.",
          "title": "City"
        },
        "county": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Enter the County or Parish.",
          "title": "County/Parish"
        },
        "state": {
          "allOf": [
            {
              "$ref": "#/$defs/StateCode"
            }
          ],
          "description": "Enter the state.",
          "title": "State"
        },
        "province": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Enter the province.",
          "title": "Province"
        },
        "country": {
          "allOf": [
            {
              "$ref": "#/$defs/CountryCode"
