{
  "type": "Group",
  "elements": [
    {
      "type": "Control",
      "scope": "#/properties/agency_name",
      "label": "Name of Federal Agency",
      "options": {
        "readonly": true
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/assistance_listing_number",
      "label": "Assistance Listing Number",
      "options": {
        "readonly": true
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/assistance_listing_program_title",
      "label": "Assistance Listing Title",
      "options": {
        "readonly": true
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/date_received",
      "label": "Date Received",
      "options": {
        "readonly": true
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/funding_opportunity_number",
      "label": "Funding Opportunity Number",
      "options": {
        "readonly": true
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/funding_opportunity_title",
      "label": "Funding Opportunity Title",
      "options": {
        "readonly": true
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/organization_name",
      "label": "Legal Name"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/applicant/properties/street1",
          "label": "Street 1"
        },
        {
          "type": "Control",
          "scope": "#/properties/applicant/properties/street2",
          "label": "Street 2"
        },
        {
          "type": "Control",
          "scope": "#/properties/applicant/properties/city",
          "label": "City"
        },
        {
          "type": "Control",
          "scope": "#/properties/applicant/properties/county",
          "label": "County/Parish"
        },
        {
          "type": "Control",
          "scope": "#/properties/applicant/properties/state",
          "label": "State",
          "rule": {
            "effect": "ENABLE",
            "condition": {
              "scope": "#/properties/applicant/properties/country",
              "schema": {
                "const": "USA: UNITED STATES"
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/applicant/properties/province",
          "label": "Province",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "failWhenUndefined": true,
              "scope": "#/properties/applicant/properties/country",
              "schema": {
                "allOf": [
                  {
                    "not": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "const": ""
                        },
                        {
                          "type": "array",
                          "maxItems": 0
                        }
                      ]
                    }
                  },
                  {
                    "not": {
                      "const": "USA: UNITED STATES"
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/applicant/properties/country",
          "label": "Country"
        },
        {
          "type": "Control",
          "scope": "#/properties/applicant/properties/zip_code",
          "label": "Zip / Postal Code"
        }
      ],
      "label": "Address"
    },
    {
      "type": "Control",
      "scope": "#/properties/applicant_web_address",
      "label": "Web Address"
    },
    {
      "type": "Group",
      "elements": [],
      "label": "Type of Applicant"
    },
    {
      "type": "Control",
      "scope": "#/properties/applicant_type_other_specify",
      "label": "Type of Applicant Other Explanation"
    },
    {
      "type": "Control",
      "scope": "#/properties/employer_taxpayer_identification_number",
      "label": "EIN/TIN"
    },
    {
      "type": "Control",
      "scope": "#/properties/sam_uei",
      "label": "SAM UEI",
      "options": {
        "readonly": true
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/congressional_district_applicant",
      "label": "Congressional District of Applicant"
    },
    {
      "type": "Control",
      "scope": "#/properties/project_title",
      "label": "Project Title"
    },
    {
      "type": "Control",
      "scope": "#/properties/project_description",
      "label": "Project Description"
    },
    {
      "type": "Control",
      "scope": "#/properties/project_start_date",
      "label": "Project Start Date"
    },
    {
      "type": "Control",
      "scope": "#/properties/project_end_date",
      "label": "Project End Date"
    },
    {
      "type": "Control",
      "scope": "#/properties/project_director",
      "label": "Project Director"
    },
    {
      "type": "Control",
      "scope": "#/properties/same_as_project_director",
      "label": "Same as Project Director (if checked, fill in information same as Project Director above)"
    },
    {
      "type": "Control",
      "scope": "#/properties/contact_person",
      "label": "Primary Contact/Grants Administrator"
    },
    {
      "type": "Control",
      "scope": "#/properties/application_certification",
      "label": "** I Agree"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/authorized_representative/properties/prefix",
          "label": "Prefix"
        },
        {
          "type": "Control",
          "scope": "#/properties/authorized_representative/properties/first_name",
          "label": "First Name"
        },
        {
          "type": "Control",
          "scope": "#/properties/authorized_representative/properties/middle_name",
          "label": "Middle Name"
        },
        {
          "type": "Control",
          "scope": "#/properties/authorized_representative/properties/last_name",
          "label": "Last Name"
        },
        {
          "type": "Control",
          "scope": "#/properties/authorized_representative/properties/suffix",
          "label": "Suffix"
        }
      ],
      "label": "Authorized Representative"
    },
    {
      "type": "Control",
      "scope": "#/properties/authorized_representative_title",
      "label": "Title"
    },
    {
      "type": "Control",
      "scope": "#/properties/authorized_representative_email",
      "label": "Email"
    },
    {
      "type": "Control",
      "scope": "#/properties/authorized_representative_phone_number",
      "label": "Telephone Number"
    },
    {
      "type": "Control",
      "scope": "#/properties/authorized_representative_fax",
      "label": "Fax Number"
    },
    {
      "type": "Control",
      "scope": "#/properties/aor_signature",
      "label": "Signature of Authorized Representative",
      "options": {
        "readonly": true
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/authorized_representative_date_signed",
      "label": "Date Signed",
      "options": {
        "readonly": true
      }
    }
  ],
  "label": "Application for Federal Domestic Assistance-Short Organizational (SF-424)"
}
