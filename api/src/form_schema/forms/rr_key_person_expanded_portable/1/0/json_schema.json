{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "principal_investigator": {
      "allOf": [
        {
          "$ref": "#/$defs/PrincipalInvestigatorProfile"
        }
      ],
      "description": "The project director or principal investigator for this application.",
      "title": "Project Director / Principal Investigator"
    },
    "senior_key_persons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/details"
      },
      "maxItems": 99,
      "description": "Add every other senior or key person on the project.",
      "title": "Senior / Key Person"
    },
    "additional_profiles": {
      "allOf": [
        {
          "$ref": "#/$defs/additional_profiles_upload"
        }
      ],
      "description": "Attach the profiles that did not fit above.",
      "title": "Additional Senior / Key Person Profiles"
    },
    "additional_biographical_sketches": {
      "allOf": [
        {
          "$ref": "#/$defs/additional_biographical_sketches_upload"
        }
      ],
      "description": "Attach the biographical sketches that did not fit above.",
      "title": "Additional Biographical Sketches"
    },
    "additional_current_pending_support": {
      "allOf": [
        {
          "$ref": "#/$defs/additional_support_upload"
        }
      ],
      "description": "Attach the current and pending support records that did not fit above.",
      "title": "Additional Current and Pending Support"
    }
  },
  "required": [
    "principal_investigator"
  ],
  "description": "Research & Related Senior/Key Person Profile (Expanded), Grants.gov version 4.0.",
  "$defs": {
    "ResearchProjectRole": {
      "type": "string",
      "enum": [
        "PD/PI",
        "Co-PD/PI",
        "Faculty",
        "Post Doctoral",
        "Post Doctoral Associate",
        "Post Doctoral Scholar",
        "Other Professional",
        "Graduate Student",
        "Undergraduate Student",
        "Technician",
        "Consultant",
        "Co-Investigator",
        "Other (Specify)"
      ],
      "description": "The roles the R&R forms recognize for a senior or key person.\n\nA closed list, unlike `poc/project-role`, which the Key Contacts form asks as free text.\nTwo forms asking \"what is this person's role\" and meaning different things by the answer."
    },
    "PrincipalInvestigatorProfile": {
      "type": "object",
      "properties": {
        "project_role": {
          "allOf": [
            {
              "$ref": "#/$defs/ResearchProjectRole"
            }
          ],
          "default": "PD/PI",
          "description": "The role is fixed for this person.",
          "title": "Project Role"
        },
        "biographical_sketch": {
          "allOf": [
            {
              "$ref": "#/$defs/biographical_sketch_2"
            }
          ],
          "description": "Attach the PD/PI's biographical sketch. Required for this person.",
          "title": "Attach Biographical Sketch"
        }
      },
      "required": [
        "project_role",
        "biographical_sketch"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/details"
        }
      ],
      "description": "The PD/PI is one senior/key person whose role is fixed and whose biographical sketch is\nmandatory. Everything else about them is the same question every other key person answers."
    },
    "details": {
      "type": "object",
      "properties": {
        "name": {
          "allOf": [
            {
              "$ref": "#/$defs/name"
            }
          ],
          "description": "Enter the person's name. First and last name are required.",
          "title": "Name"
        },
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/contact_title"
            }
          ],
          "description": "Enter the person's position or title.",
          "title": "Position / Title"
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Enter the department this person belongs to.",
          "title": "Department"
        },
        "organization_name": {
          "allOf": [
            {
              "$ref": "#/$defs/organization_name"
            }
          ],
          "description": "Enter the name of the organization this person belongs to.",
          "title": "Organization Name"
        },
        "division": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Enter the division this person belongs to.",
          "title": "Division"
        },
        "address": {
          "allOf": [
            {
              "$ref": "#/$defs/address_nine_digit_zip"
            },
            {
              "if": {
                "properties": {
                  "country": {
                    "const": "USA: UNITED STATES"
                  }
                },
                "required": [
                  "country"
                ]
              },
              "then": {
                "required": [
                  "zip_code"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "country": {
                    "const": "USA: UNITED STATES"
                  }
                },
                "required": [
                  "country"
                ]
              },
              "then": {
                "required": [
                  "state"
                ]
              }
            }
          ],
          "description": "Enter the person's address.",
          "title": "Address",
          "required": [
            "street1",
            "city",
            "country"
          ]
        },
        "phone": {
          "allOf": [
            {
              "$ref": "#/$defs/phone"
            }
          ],
          "description": "Enter the person's telephone number.",
          "title": "Phone Number"
        },
        "fax": {
          "allOf": [
            {
              "$ref": "#/$defs/phone"
            }
          ],
          "description": "Enter the person's fax number.",
          "title": "Fax Number"
        },
        "email": {
          "allOf": [
            {
              "$ref": "#/$defs/email"
            }
          ],
          "description": "Enter the person's email address.",
          "title": "Email"
        },
        "credential": {
          "allOf": [
            {
              "$ref": "#/$defs/credential"
            }
          ],
          "description": "Enter the person's agency credential or login, when applicable.",
          "title": "Credential, e.g., agency login"
        },
        "project_role": {
          "allOf": [
            {
              "$ref": "#/$defs/ResearchProjectRole"
            }
          ],
          "description": "Select this person's role on the project.",
          "title": "Project Role"
        },
        "other_project_role": {
          "allOf": [
            {
              "$ref": "#/$defs/other_project_role"
            }
          ],
          "description": "Name the role when one of the Other categories is selected.",
          "title": "Other Project Role Category"
        },
        "degree_type": {
          "allOf": [
            {
              "$ref": "#/$defs/degree_type"
            }
          ],
          "description": "Enter the type of degree this person holds.",
          "title": "Degree Type"
        },
        "degree_year": {
          "allOf": [
            {
              "$ref": "#/$defs/degree_year"
            }
          ],
          "description": "Enter the year this person's degree was awarded.",
          "title": "Degree Year"
        },
        "biographical_sketch": {
          "allOf": [
            {
              "$ref": "#/$defs/biographical_sketch"
            }
          ],
          "description": "Attach this person's biographical sketch.",
          "title": "Attach Biographical Sketch"
        },
        "current_pending_support": {
          "allOf": [
            {
              "$ref": "#/$defs/current_pending_support"
            }
          ],
          "description": "Attach this person's current and pending support.",
          "title": "Attach Current & Pending Support"
        }
      },
      "required": [
        "name",
        "address",
        "phone",
        "email",
        "project_role"
      ],
      "description": "Identity, affiliation, contact details, role, credential and supporting documents for one\nsenior or key person on a research project.\n\nDeliberately not `poc/details` with extra fields. A point of contact is someone to ask\nabout the application; a senior/key person is someone the award is evaluated on, which is\nwhy this one carries a degree, a credential and a biographical sketch, and why its role is\na closed list. The two share a shape and mean different things.",
      "title": "Senior / Key Person",
      "allOf": [
        {
          "if": {
            "properties": {
              "project_role": {
                "const": "Other (Specify)"
              }
            },
            "required": [
              "project_role"
            ]
          },
          "then": {
            "required": [
              "other_project_role"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "project_role": {
                "const": "Other Professional"
              }
            },
            "required": [
              "project_role"
            ]
          },
          "then": {
            "required": [
              "other_project_role"
            ]
          }
        }
      ]
    },
    "name": {
      "type": "object",
      "properties": {
        "prefix": {
          "allOf": [
            {
              "$ref": "#/$defs/ResearchPersonPrefix"
            }
          ],
          "description": "Enter the Prefix.",
          "title": "Prefix"
        },
        "first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 35,
          "description": "Enter the First Name.",
          "title": "First Name"
        },
        "middle_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 25,
          "description": "Enter the Middle Name.",
          "title": "Middle Name"
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Enter the Last Name.",
          "title": "Last Name"
        },
        "suffix": {
          "allOf": [
            {
              "$ref": "#/$defs/ResearchPersonSuffix"
            }
          ],
          "description": "Enter the Suffix.",
          "title": "Suffix"
        }
      },
      "required": [
        "first_name",
        "last_name"
      ],
      "description": "Enter the research person's name as it appears in official records.",
      "title": "Name"
    },
    "ResearchPersonPrefix": {
      "type": "string",
      "enum": [
        "Mr.",
        "Mrs.",
        "Miss",
        "Ms.",
        "Dr.",
        "Rev.",
        "Prof."
      ],
      "description": "The prefixes the R&R forms offer, as a closed list rather than free text."
    },
    "ResearchPersonSuffix": {
      "type": "string",
      "enum": [
        "Jr.",
        "Sr.",
        "M.D.",
        "Ph.D",
        "JD"
      ],
      "description": "The suffixes the R&R forms offer, as a closed list rather than free text."
    },
    "contact_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 45,
      "description": "Enter the position title.",
      "title": "Title"
    },
    "organization_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "Enter the legal name of the organization.",
      "title": "Organization Name"
    },
    "address_nine_digit_zip": {
      "type": "object",
      "properties": {
        "zip_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Enter the nine-digit Postal Code (e.g., ZIP Code). This field is required if the Country is the United States.",
          "title": "Zip / Postal Code"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/address"
        },
        {
          "if": {
            "properties": {
              "country": {
                "const": "USA: UNITED STATES"
              }
            },
            "required": [
              "country"
            ]
          },
          "then": {
            "properties": {
              "zip_code": {
                "minLength": 9
              }
            }
          }
        }
      ],
      "description": "The same address, asked with the stricter of the two US postal-code rules in circulation.\n\n`ZipPostalCodeDataType` in GlobalLibrary-V2.0.xsd bounds the field at 1..30 characters and\nsays nothing about nine digits, so this is not a structural constraint -- it comes from the\nform instructions, which read \"Enter the nine-digit Postal Code (e.g., ZIP Code)\". Forms\ndisagree about whether they mean it: some accept a five-digit ZIP, and the R&R family does\nnot.\n\nA separate question rather than a tightening of `generics/address`, for the reason\n`MonetaryAmountMax12Digits` is separate from `MonetaryAmount`: moving the rule onto the\nshared address would silently raise the bar for every form already asking for one, and a\nform that accepts a five-digit ZIP is not asking this question badly, it is asking a\ndifferent question. Named for the rule rather than for the forms that currently hold it.",
      "title": "Address"
    },
    "address": {
      "type": "object",
      "properties": {
        "street1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 55,
          "description": "Enter the first line of the Street Address.",
          "title": "Street 1"
        },
        "street2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 55,
          "description": "Enter the second line of the Street Address.",
          "title": "Street 2"
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 35,
          "description": "Enter the city.",
          "title": "City"
        },
        "county": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Enter the County or Parish.",
          "title": "County/Parish"
        },
        "state": {
          "allOf": [
            {
              "$ref": "#/$defs/StateCode"
            }
          ],
          "description": "Enter the state.",
          "title": "State"
        },
        "province": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Enter the province.",
          "title": "Province"
        },
        "country": {
          "allOf": [
            {
              "$ref": "#/$defs/CountryCode"
            }
          ],
          "description": "Enter the country.",
          "title": "Country"
        },
        "zip_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Enter the nine-digit Postal Code (e.g., ZIP Code). This field is required if the Country is the United States.",
          "title": "Zip / Postal Code"
        }
      },
      "description": "Enter an address.",
      "title": "Address"
    },
