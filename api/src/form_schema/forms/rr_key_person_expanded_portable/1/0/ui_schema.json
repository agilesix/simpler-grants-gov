                "minimum": 99
              },
              {
                "op": "present",
                "ref": {
                  "scope": "root",
                  "pointer": "/additionalProfiles"
                }
              }
            ]
          },
          "then": {
            "interaction": "enabled"
          },
          "otherwise": {
            "interaction": "disabled"
