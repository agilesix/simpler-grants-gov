      {
        "type": "field",
        "definition": "/properties/principal_investigator/properties/address/properties/city"
      },
      {
        "type": "field",
        "definition": "/properties/principal_investigator/properties/address/properties/county"
      },
      {
        "type": "field",
        "definition": "/properties/principal_investigator/properties/address/properties/state",
        "conditional": {
          "when": {
            "op": "equals",
            "ref": {
              "scope": "root",
              "pointer": "/principalInvestigator/address/country"
            },
            "value": "USA: UNITED STATES"
          },
          "then": {
            "interaction": "enabled"
          },
          "otherwise": {
            "interaction": "disabled"
          }
        }
      },
      {
        "type": "field",
        "definition": "/properties/principal_investigator/properties/address/properties/province",
        "conditional": {
          "when": {
            "op": "notEquals",
            "ref": {
              "scope": "root",
              "pointer": "/principalInvestigator/address/country"
            },
            "value": "USA: UNITED STATES"
          },
          "then": {
            "interaction": "enabled"
          },
          "otherwise": {
            "interaction": "disabled"
          }
        }
      },
      {
        "type": "field",
        "definition": "/properties/principal_investigator/properties/address/properties/country"
      },
      {
        "type": "field",
        "definition": "/properties/principal_investigator/properties/address/properties/zip_code"
      },
      {
        "type": "field",
        "definition": "/properties/principal_investigator/properties/phone"
      },
      {
        "type": "field",
        "definition": "/properties/principal_investigator/properties/fax"
      },
      {
        "type": "field",
        "definition": "/properties/principal_investigator/properties/email"
      },
      {
        "type": "field",
        "definition": "/properties/principal_investigator/properties/credential"
      },
      {
        "type": "field",
        "definition": "/properties/principal_investigator/properties/project_role"
      },
      {
        "type": "field",
        "definition": "/properties/principal_investigator/properties/other_project_role",
        "conditional": {
          "when": {
            "op": "in",
            "ref": {
              "scope": "root",
              "pointer": "/principalInvestigator/projectRole"
            },
            "values": [
              "Other Professional",
              "Other (Specify)"
            ]
          },
          "then": {
            "interaction": "enabled"
          },
          "otherwise": {
            "interaction": "disabled"
          }
        }
      },
      {
        "type": "field",
        "definition": "/properties/principal_investigator/properties/degree_type"
      },
      {
        "type": "field",
        "definition": "/properties/principal_investigator/properties/degree_year"
      },
      {
        "type": "field",
        "definition": "/properties/principal_investigator/properties/biographical_sketch",
        "widget": "Attachment"
      },
      {
        "type": "field",
        "definition": "/properties/principal_investigator/properties/current_pending_support",
        "widget": "Attachment"
      }
    ]
  },
