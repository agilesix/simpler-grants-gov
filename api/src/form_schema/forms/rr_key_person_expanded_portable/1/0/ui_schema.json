  {
    "type": "section",
    "name": "overflowAttachments",
    "label": "Additional Senior / Key Person Attachments",
    "children": [
      {
        "type": "field",
        "definition": "/properties/additional_profiles",
        "widget": "Attachment",
        "conditional": {
          "when": {
            "op": "any",
            "predicates": [
              {
                "op": "countAtLeast",
                "ref": {
                  "scope": "root",
                  "pointer": "/seniorKeyPersons"
