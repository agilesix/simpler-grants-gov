            "description": "Enter the position title.",
            "title": "Title"
          },
          "address": {
            "allOf": [
              {
                "$ref": "#/$defs/address"
              },
              {
                "if": {
                  "properties": {
                    "country": {
                      "const": "USA: UNITED STATES"
                    }
                  },
                  "required": [
                    "country"
                  ]
                },
                "then": {
                  "required": [
                    "zip_code"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "country": {
                      "const": "USA: UNITED STATES"
                    }
                  },
                  "required": [
                    "country"
                  ]
                },
                "then": {
                  "required": [
                    "state"
