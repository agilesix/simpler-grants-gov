                }
              }
            ],
            "description": "Enter the address.",
            "required": [
              "street1",
              "city",
              "country"
            ]
          }
        },
        "required": [
          "address"
        ],
        "allOf": [
          {
            "$ref": "#/$defs/contact_details"
