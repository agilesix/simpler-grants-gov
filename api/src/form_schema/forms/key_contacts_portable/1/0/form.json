        "required": [
          "name",
          "phone",
          "email"
        ],
        "description": "A person and the ways to reach them.\n\nThe shape only. Who the person *is* to the application -- a point of contact, the\nrepresentative authorized to sign -- is a different question, because the roles are not\ninterchangeable and a form asks for both. Those extend this.\n\nThe person's title is deliberately not here. A point of contact may not have one; a\nrepresentative authorized to bind the organization does, because their title is how you\nknow they are authorized. So each of those declares it, with the optionality it has.",
        "title": "Contact"
      },
      "person_name": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10,
            "description": "Enter the Prefix.",
            "title": "Prefix"
          },
          "first_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 35,
            "description": "Enter the First Name.",
            "title": "First Name"
          },
          "middle_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 25,
            "description": "Enter the Middle Name.",
            "title": "Middle Name"
          },
          "last_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Enter the Last Name.",
            "title": "Last Name"
          },
          "suffix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10,
            "description": "Enter the Suffix.",
            "title": "Suffix"
          }
        },
        "description": "A person's name, in five parts.",
        "title": "Name"
      },
      "phone": {
        "type": "string",
        "minLength": 1,
        "maxLength": 25,
        "description": "A telephone or fax number."
      },
      "email": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60,
        "format": "email",
        "description": "An email address.\n\n`globLib:EmailDataType` is minLength 1, maxLength 60, so both bounds are declared here.\n`format: email` already rejects the empty string, which makes the minimum redundant in\npractice -- but the constraint the Grants.gov type states should be stated, not left to\nfollow from another assertion that could be relaxed independently.",
        "title": "Email"
      }
    }
