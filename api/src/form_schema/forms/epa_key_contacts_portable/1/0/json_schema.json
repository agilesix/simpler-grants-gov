{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "authorized_representative": {
      "allOf": [
        {
          "$ref": "#/$defs/EPAKeyContactPerson"
        }
      ],
      "description": "Original awards and amendments will be sent to this individual for review and acceptance, unless otherwise indicated.",
      "title": "Authorized Representative",
      "properties": {
        "name": {
          "required": [
            "first_name",
            "last_name"
          ]
        },
        "address": {
          "required": [
            "street1",
            "city",
            "country"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "country": {
                    "const": "USA: UNITED STATES"
                  }
                },
                "required": [
                  "country"
                ]
              },
              "then": {
                "required": [
                  "zip_code"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "country": {
                    "const": "USA: UNITED STATES"
                  }
                },
                "required": [
                  "country"
                ]
              },
              "then": {
                "required": [
                  "state"
                ]
              }
            }
          ]
        }
      }
    },
    "payee": {
      "allOf": [
        {
          "$ref": "#/$defs/EPAKeyContactPerson"
        }
      ],
      "description": "Individual authorized to accept payments.",
      "title": "Payee",
      "properties": {
        "name": {
          "required": [
            "first_name",
            "last_name"
          ]
        },
        "address": {
          "required": [
            "street1",
            "city",
            "country"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "country": {
                    "const": "USA: UNITED STATES"
                  }
                },
                "required": [
                  "country"
                ]
              },
              "then": {
                "required": [
                  "zip_code"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "country": {
                    "const": "USA: UNITED STATES"
                  }
                },
                "required": [
                  "country"
                ]
              },
              "then": {
                "required": [
                  "state"
                ]
              }
            }
          ]
        }
      }
    },
    "administrative_contact": {
      "allOf": [
        {
          "$ref": "#/$defs/EPAKeyContactPerson"
        }
      ],
      "description": "Individual from Sponsored Programs Office to contact concerning administrative matters (i.e., indirect cost rate computation, rebudgeting requests etc).",
      "title": "Administrative Contact",
      "properties": {
        "name": {
          "required": [
            "first_name",
            "last_name"
          ]
        },
        "address": {
          "required": [
            "street1",
            "city",
            "country"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "country": {
                    "const": "USA: UNITED STATES"
                  }
                },
                "required": [
                  "country"
                ]
              },
              "then": {
                "required": [
                  "zip_code"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "country": {
                    "const": "USA: UNITED STATES"
                  }
                },
                "required": [
                  "country"
                ]
              },
              "then": {
                "required": [
                  "state"
                ]
              }
            }
          ]
        }
      }
    },
    "project_manager": {
      "allOf": [
        {
          "$ref": "#/$defs/EPAKeyContactPerson"
        }
      ],
      "description": "Individual responsible for the technical completion of the proposed work.",
      "title": "Project Manager",
      "properties": {
        "name": {
          "required": [
            "first_name",
            "last_name"
          ]
        },
        "address": {
          "required": [
            "street1",
            "city",
            "country"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "country": {
                    "const": "USA: UNITED STATES"
                  }
                },
                "required": [
                  "country"
                ]
              },
              "then": {
                "required": [
                  "zip_code"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "country": {
                    "const": "USA: UNITED STATES"
                  }
                },
                "required": [
                  "country"
                ]
              },
              "then": {
                "required": [
                  "state"
                ]
              }
            }
          ]
        }
      }
    }
  },
  "description": "EPA KEY CONTACTS FORM, Grants.gov version 2.0.",
  "$defs": {
    "EPAKeyContactPerson": {
      "type": "object",
      "properties": {
        "name": {
          "allOf": [
            {
              "$ref": "#/$defs/person_name"
            }
          ],
          "description": "Enter the contact's name. First and last name are required.",
          "title": "Name",
          "required": [
            "first_name",
            "last_name"
          ]
        },
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/contact_title"
            }
          ],
          "description": "Enter the contact's position title.",
          "title": "Title"
        },
        "address": {
          "allOf": [
            {
              "$ref": "#/$defs/address"
            },
            {
              "if": {
                "properties": {
                  "country": {
                    "const": "USA: UNITED STATES"
                  }
                },
                "required": [
                  "country"
                ]
              },
              "then": {
                "required": [
                  "zip_code"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "country": {
                    "const": "USA: UNITED STATES"
                  }
                },
                "required": [
                  "country"
                ]
              },
              "then": {
                "required": [
                  "state"
                ]
              }
            }
          ],
          "description": "Enter the contact's complete address.",
          "title": "Complete Address",
          "required": [
            "street1",
            "city",
            "country"
          ]
        },
        "phone": {
          "allOf": [
            {
              "$ref": "#/$defs/phone"
            }
          ],
          "description": "Enter the contact's telephone number.",
          "title": "Phone Number"
        },
        "fax": {
          "allOf": [
            {
              "$ref": "#/$defs/phone"
            }
          ],
          "description": "Enter the contact's fax number.",
          "title": "Fax Number"
        },
        "email": {
          "allOf": [
            {
              "$ref": "#/$defs/email"
            }
          ],
          "description": "Enter the contact's e-mail address.",
          "title": "E-mail Address"
        }
      },
      "required": [
        "name",
        "address",
        "phone"
      ],
      "description": "One source-defined EPA contact person.\n\nNot `poc/details`, which requires an email and is asked as a list. EPA asks for four named\nroles, each optional as a whole, and each complete once it exists: first and last name,\nstreet 1, city, country and phone become required the moment any part of the role is\nanswered, while email stays optional throughout. That completeness boundary is the whole\nshape of this question, and it is the one thing `poc/details` does not say.",
      "title": "Contact Person"
    },
    "person_name": {
      "type": "object",
      "properties": {
        "prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "description": "Enter the Prefix.",
          "title": "Prefix"
        },
        "first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 35,
          "description": "Enter the First Name.",
          "title": "First Name"
        },
        "middle_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 25,
          "description": "Enter the Middle Name.",
          "title": "Middle Name"
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Enter the Last Name.",
          "title": "Last Name"
        },
        "suffix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "description": "Enter the Suffix.",
          "title": "Suffix"
        }
      },
      "description": "A person's name, in five parts.",
      "title": "Name"
    },
    "contact_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 45,
      "description": "Enter the position title.",
      "title": "Title"
    },
    "address": {
      "type": "object",
      "properties": {
        "street1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 55,
          "description": "Enter the first line of the Street Address.",
          "title": "Street 1"
        },
        "street2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 55,
          "description": "Enter the second line of the Street Address.",
          "title": "Street 2"
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 35,
          "description": "Enter the city.",
          "title": "City"
        },
        "county": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Enter the County or Parish.",
          "title": "County/Parish"
        },
        "state": {
          "allOf": [
            {
              "$ref": "#/$defs/StateCode"
            }
          ],
          "description": "Enter the state.",
          "title": "State"
        },
        "province": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Enter the province.",
          "title": "Province"
        },
        "country": {
          "allOf": [
            {
              "$ref": "#/$defs/CountryCode"
            }
          ],
          "description": "Enter the country.",
          "title": "Country"
        },
        "zip_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Enter the nine-digit Postal Code (e.g., ZIP Code). This field is required if the Country is the United States.",
          "title": "Zip / Postal Code"
        }
      },
      "description": "Enter an address.",
      "title": "Address"
    },
