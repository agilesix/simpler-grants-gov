{
  "opportunity": {
    "agency_name": {
      "gg_pre_population": {
        "rule": "agency_name"
      }
    },
    "assistance_listing": {
      "number": {
        "gg_pre_population": {
          "rule": "assistance_listing_number"
        }
      },
      "title": {
        "gg_pre_population": {
          "rule": "assistance_listing_program_title"
        }
      }
    },
    "number": {
      "gg_pre_population": {
        "rule": "opportunity_number"
      }
    },
    "title": {
      "gg_pre_population": {
        "rule": "opportunity_title"
      }
    }
  },
  "date_received": {
    "gg_post_population": {
      "rule": "current_date"
    }
  },
  "project": {
    "end_date": {
      "gg_validation": {
        "rule": "date_not_before",
        "source_field": "start_date"
      }
    }
  },
  "certification": {
    "signature": {
      "gg_post_population": {
        "rule": "signature"
      }
    },
    "date_signed": {
      "gg_post_population": {
        "rule": "current_date"
      }
    }
  }
}
