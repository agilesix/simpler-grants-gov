          "description": "Enter the evening telephone number.",
          "title": "Phone Number (Evening)"
        },
        "fax": {
          "$ref": "#/$defs/person.fax-number"
        },
        "email": {
          "$ref": "#/$defs/person.email"
        },
        "citizenship": {
          "allOf": [
