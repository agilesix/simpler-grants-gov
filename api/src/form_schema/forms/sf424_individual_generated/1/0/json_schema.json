    "Citizenship": {
      "type": "object",
      "properties": {
        "is_us_citizen": {
          "type": "boolean",
          "title": "U.S. Citizenship"
        },
        "alien_registration_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 14,
          "description": "Enter the Alien Registration Number.",
          "title": "If permanent resident of U.S., enter the Alien Registration #"
        },
        "country_of_citizenship": {
          "allOf": [
            {
              "$ref": "#/$defs/CountryCode"
            }
          ],
          "description": "Select the country. This field is required if the applicant is not a U.S. citizen.",
          "title": "If foreign national, enter country of citizenship"
        },
        "residency_start_date": {
          "type": "string",
          "format": "date",
          "description": "Enter the start date of the most recent residency in the U.S. This field is required if the applicant is not a U.S. citizen.",
          "title": "If foreign national, enter start date of most recent residency in U.S."
        }
      },
      "required": [
        "is_us_citizen"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "is_us_citizen": {
                "const": false
              }
            },
            "required": [
              "is_us_citizen"
            ]
          },
          "then": {
            "required": [
              "country_of_citizenship",
              "residency_start_date"
            ]
          }
        }
      ]
    },
    "Applicant": {
      "type": "object",
