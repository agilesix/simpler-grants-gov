        },
        "description": {
          "$ref": "#/$defs/project.description"
        },
        "start_date": {
          "$ref": "#/$defs/project.start-date"
        },
        "end_date": {
          "allOf": [
            {
              "$ref": "#/$defs/project.end-date"
            }
          ],
