      "AuthorizedRepresentativeOrganizationalAffiliation": {
        "$field": "authorized_representative.organizational_affiliation"
      },
      "AuthorizedRepresentativePhoneNumber": {
        "$field": "authorized_representative.phone"
      },
      "AuthorizedRepresentativeFax": {
        "$field": "authorized_representative.fax"
      },
      "AuthorizedRepresentativeEmail": {
        "$field": "authorized_representative.email"
      },
      "AuthorizedRepresentativeSignature": {
        "$field": "authorized_representative.signature"
      },
      "AuthorizedRepresentativeSignatureDate": {
        "$field": "authorized_representative.date_signed"
