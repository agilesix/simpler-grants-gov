          "globLib:Country": {
            "$field": "applicant.address.country"
          }
        },
        "globLib:EIN": {
          "$field": "applicant.ein"
        }
      },
      "ContactName": {
        "globLib:PrefixName": {
          "$field": "contact.name.prefix"
