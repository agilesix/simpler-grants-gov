        "globLib:PrefixName": {
          "$field": "authorized_representative.name.prefix"
        },
        "globLib:FirstName": {
          "$field": "authorized_representative.name.first_name"
        },
        "globLib:MiddleName": {
          "$field": "authorized_representative.name.middle_name"
        },
        "globLib:LastName": {
          "$field": "authorized_representative.name.last_name"
        },
        "globLib:SuffixName": {
          "$field": "authorized_representative.name.suffix"
        }
      },
      "AuthorizedRepresentativeTitle": {
        "$field": "authorized_representative.title"
