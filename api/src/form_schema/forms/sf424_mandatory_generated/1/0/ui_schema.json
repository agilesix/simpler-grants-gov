{
  "type": "Group",
  "elements": [
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/application/properties/submission_type",
          "options": {
            "widget": "Select"
          },
          "label": "1a. Type of Submission"
        },
        {
          "type": "Control",
          "scope": "#/properties/application/properties/submission_type_other",
          "options": {
            "widget": "TextArea"
          },
          "rule": {
            "effect": "ENABLE",
            "condition": {
              "scope": "#/properties/application/properties/submission_type",
              "schema": {
                "const": "Other"
              }
            }
          },
          "label": "Type of Submission - Other (specify)"
        },
        {
          "type": "Control",
          "scope": "#/properties/application/properties/frequency/properties/code",
          "options": {
            "widget": "Select"
          },
          "label": "1b. Frequency"
        },
        {
          "type": "Control",
          "scope": "#/properties/application/properties/frequency/properties/other",
          "options": {
            "widget": "TextArea"
          },
          "rule": {
            "effect": "ENABLE",
            "condition": {
              "scope": "#/properties/application/properties/frequency/properties/code",
              "schema": {
                "const": "Other"
              }
            }
          },
          "label": "Frequency - Other (specify)"
        },
        {
          "type": "Control",
          "scope": "#/properties/application/properties/consolidated_request/properties/answer",
          "label": "1c. Consolidated Application/Plan/Funding Request?",
          "options": {
            "widget": "Radio"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/application/properties/consolidated_request/properties/explanation",
          "options": {
            "widget": "TextArea"
          },
          "rule": {
            "effect": "ENABLE",
            "condition": {
              "scope": "#/properties/application/properties/consolidated_request/properties/answer",
              "schema": {
                "const": true
              }
            }
          },
          "label": "Consolidated Application/Plan/Funding Request Explanation"
        },
        {
          "type": "Control",
          "scope": "#/properties/application/properties/version",
          "options": {
            "widget": "Select"
          },
          "label": "1d. Version"
        }
      ],
      "label": "1. Type of Submission"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/application/properties/date_received",
          "label": "Date Received",
          "options": {
            "readonly": true
          }
        }
      ],
      "label": "2. Date Received"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/application/properties/applicant_id",
          "label": "Applicant Identifier"
        }
      ],
      "label": "3. Applicant Identifier"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/application/properties/federal_entity_identifier",
          "label": "4a. Federal Entity Identifier"
        },
        {
          "type": "Control",
          "scope": "#/properties/application/properties/federal_award_identifier",
          "label": "4b. Federal Award Identifier"
        }
      ],
      "label": "4. Federal Identifiers"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/application/properties/state/properties/received_date",
          "label": "Date Received by State"
        }
      ],
      "label": "5. Date Received by State"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/application/properties/state/properties/application_id",
          "label": "State Application Identifier"
        }
      ],
      "label": "6. State Application Identifier"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/applicant/properties/organization/properties/name",
          "label": "7a. Legal Name"
        },
        {
          "type": "Control",
          "scope": "#/properties/applicant/properties/organization/properties/ein",
          "label": "7b. Employer/Taxpayer Identification Number (EIN/TIN)"
        },
        {
          "type": "Control",
          "scope": "#/properties/applicant/properties/organization/properties/uei",
          "label": "7c. UEI",
          "options": {
            "readonly": true
          }
        },
        {
          "type": "Group",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/applicant/properties/organization/properties/address/properties/street1",
              "label": "Street 1"
            },
            {
              "type": "Control",
              "scope": "#/properties/applicant/properties/organization/properties/address/properties/street2",
              "label": "Street 2"
            },
            {
              "type": "Control",
              "scope": "#/properties/applicant/properties/organization/properties/address/properties/city",
              "label": "City"
            },
            {
              "type": "Control",
              "scope": "#/properties/applicant/properties/organization/properties/address/properties/county",
              "label": "County/Parish"
            },
            {
              "type": "Control",
              "scope": "#/properties/applicant/properties/organization/properties/address/properties/state",
              "label": "State"
            },
            {
              "type": "Control",
              "scope": "#/properties/applicant/properties/organization/properties/address/properties/province",
              "label": "Province",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/applicant/properties/organization/properties/address/properties/country",
                  "schema": {
                    "allOf": [
                      {
                        "not": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "const": ""
                            },
                            {
                              "type": "array",
                              "maxItems": 0
                            }
                          ]
                        }
                      },
                      {
                        "not": {
                          "const": "USA: UNITED STATES"
                        }
                      }
                    ]
                  },
                  "failWhenUndefined": true
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/applicant/properties/organization/properties/address/properties/country",
              "label": "Country"
            },
            {
              "type": "Control",
              "scope": "#/properties/applicant/properties/organization/properties/address/properties/zip_code",
              "label": "Zip / Postal Code"
            }
          ],
          "label": "7d. Address"
        },
        {
          "type": "Group",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/applicant/properties/organization/properties/department",
