        {
          "type": "Control",
          "scope": "#/properties/project/properties/congressional_district",
          "label": "13b. Program/Project"
        },
        {
          "type": "Control",
          "scope": "#/properties/project/properties/additional_congressional_districts",
          "label": "Additional Program/Project Congressional Districts",
          "options": {
            "widget": "Attachment",
            "description": "Attach an additional list of Program/Project Congressional Districts if needed."
          }
        }
      ],
      "label": "13. Congressional Districts Of"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/budget/properties/funding_period/properties/start_date",
          "label": "14a. Start Date"
        },
        {
          "type": "Control",
          "scope": "#/properties/budget/properties/funding_period/properties/end_date",
          "label": "14b. End Date"
        }
      ],
      "label": "14. Funding Period"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/budget/properties/funding_sources/properties/federal",
          "label": "15a. Federal"
        },
        {
          "type": "Control",
          "scope": "#/properties/budget/properties/funding_sources/properties/match",
          "label": "15b. Match"
        }
      ],
      "label": "15. Estimated Funding"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/application/properties/state_review/properties/status",
          "options": {
            "widget": "Select"
          },
          "label": "Is Submission Subject to Review by State Under Executive Order 12372 Process?"
        },
        {
          "type": "Control",
          "scope": "#/properties/application/properties/state_review/properties/date",
          "rule": {
            "effect": "ENABLE",
            "condition": {
              "scope": "#/properties/application/properties/state_review/properties/status",
              "schema": {
                "const": "StateReviewAvailable"
              }
            }
          },
          "label": "State Review Date"
        }
      ],
