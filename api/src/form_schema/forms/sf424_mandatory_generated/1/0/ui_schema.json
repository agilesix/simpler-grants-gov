        {
          "type": "Control",
          "scope": "#/properties/opportunity/properties/assistance_listing/properties/title",
          "label": "Assistance Listing Title",
          "options": {
            "readonly": true
          }
        }
      ],
      "label": "10. Assistance Listing"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/project/properties/title",
          "label": "Descriptive Title of Applicant's Project"
        }
      ],
      "label": "11. Descriptive Title of Applicant's Project"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/project/properties/areas_affected",
          "options": {
            "widget": "TextArea"
          },
          "label": "Areas Affected by Funding"
        }
      ],
      "label": "12. Areas Affected by Funding"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/applicant/properties/congressional_district",
          "label": "13a. Applicant"
