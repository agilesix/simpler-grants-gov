  ],
  "$defs": {
    "MandatorySubmissionType": {
      "type": "string",
      "enum": [
        "Application",
        "Plan",
        "FundingRequest",
        "Other"
      ]
    },
    "MandatoryFrequency": {
      "type": "string",
      "enum": [
        "Annual",
        "Quarterly",
        "Other"
      ]
    },
    "MandatorySubmissionVersion": {
      "type": "string",
      "enum": [
        "Initial",
        "Resubmission",
        "Revision",
        "Update"
      ]
    },
    "MandatorySubmission": {
      "type": "object",
      "properties": {
        "type": {
          "allOf": [
            {
              "$ref": "#/$defs/MandatorySubmissionType"
            }
          ],
          "description": "Select one type of submission in accordance with agency instructions.  This field is required.",
          "title": "Type of Submission"
        },
        "type_other_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Specify the type of submission in the text box.",
          "title": "Type of Submission - Other (specify)"
        },
        "frequency": {
          "allOf": [
            {
              "$ref": "#/$defs/MandatoryFrequency"
            }
          ],
          "description": "Select the applicable frequency for the type of submission.  This field is required.",
          "title": "Frequency"
        },
        "frequency_other_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Specify the frequency of the submission.",
          "title": "Frequency - Other (specify)"
        },
        "consolidated_request": {
          "type": "boolean",
          "description": "Indicate if the submission is a consolidated application/plan/funding request.",
          "title": "Consolidated Application/Plan/Funding Request?"
        },
        "consolidated_request_explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "If this is a Consolidated Application/Plan/Funding Request, please identify the programs covered by the consolidated submission as required in agency instructions.",
          "title": "Consolidated Request Explanation"
        },
        "version": {
          "allOf": [
            {
              "$ref": "#/$defs/MandatorySubmissionVersion"
            }
          ],
          "description": "Select the applicable version for the type of submission.  This field is required.",
          "title": "Version"
        }
      },
      "required": [
        "type",
        "frequency",
        "version"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Other"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "type_other_description"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "frequency": {
                "const": "Other"
              }
            },
            "required": [
              "frequency"
            ]
          },
          "then": {
            "required": [
              "frequency_other_description"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "consolidated_request": {
                "const": true
              }
            },
            "required": [
              "consolidated_request"
            ]
          },
          "then": {
            "required": [
              "consolidated_request_explanation"
            ]
          }
        }
      ]
    },
    "MandatoryDates": {
      "type": "object",
      "properties": {
        "received_date": {
          "type": "string",
          "format": "date",
          "description": "Completed by Grants.gov upon submission.",
          "title": "Date Received",
          "readOnly": true
        },
        "state_received_date": {
          "type": "string",
          "format": "date",
          "description": "Enter the date received by the State, if applicable.  Enter in the format mm/dd/yyyy.",
          "title": "Date Received by State"
        }
      }
    },
    "MandatoryIdentifiers": {
      "type": "object",
      "properties": {
        "applicant_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30,
          "description": "If you wish to use a unique identification number for your own purposes, enter it here.",
          "title": "Applicant Identifier"
        },
        "federal_entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Enter the number assigned to your organization by the Federal agency.",
          "title": "Federal Entity Identifier"
        },
        "federal_award_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 25,
          "description": "Enter the award number previously assigned by the Federal agency, if any.",
          "title": "Federal Award Identifier"
        },
        "state_application_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30,
          "description": "Enter the identifier assigned by the State, if applicable.",
          "title": "State Application Identifier"
        }
      }
    },
    "MandatoryApplicantTypeCode": {
      "type": "string",
      "enum": [
        "A: State Government",
        "B: County Government",
        "C: City or Township Government",
        "D: Special District Government",
        "E: Regional Organization",
        "F: U.S. Territory or Possession",
        "G: Independent School District",
        "H: Public/State Controlled Institution of Higher Education",
        "I: Indian/Native American Tribal Government (Federally Recognized)",
        "J: Indian/Native American Tribal Government (Other than Federally Recognized)",
        "K: Indian/Native American Tribally Designated Organization",
        "L: Public/Indian Housing Authority",
        "M: Nonprofit with 501C3 IRS Status (Other than Institution of Higher Education)",
        "N: Nonprofit without 501C3 IRS Status (Other than Institution of Higher Education)",
        "O: Private Institution of Higher Education",
        "P: Individual",
        "Q: For-Profit Organization (Other than Small Business)",
        "R: Small Business",
        "S: Hispanic-serving Institution",
        "T: Historically Black Colleges and Universities (HBCUs)",
        "U: Tribally Controlled Colleges and Universities (TCCUs)",
        "V: Alaska Native and Native Hawaiian Serving Institutions",
        "W: Non-domestic (non-US) Entity",
        "X: Other (specify)"
      ]
    },
    "MandatoryApplicantType": {
      "type": "object",
      "properties": {
        "code": {
          "allOf": [
            {
              "$ref": "#/$defs/MandatoryApplicantTypeCode"
            }
          ],
          "description": "Select the appropriate applicant type code.  This field is required.",
          "title": "Type of Applicant"
        },
        "other_specify": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "If you selected \"Other\" in 8a, specify your applicant type here.",
          "title": "Other (specify)"
        },
        "additional_description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 50,
          "description": "Enter a secondary description of applicant type, if required by the agency.",
          "title": "Additional Description"
        }
      },
      "required": [
        "code"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "X: Other (specify)"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "other_specify"
            ]
          }
        }
      ]
    },
    "MandatoryApplicant": {
      "type": "object",
      "properties": {
        "legal_name": {
          "allOf": [
            {
              "$ref": "#/$defs/organization.name"
            }
          ],
          "description": "Enter the legal name of the organization.",
          "title": "Legal Name"
        },
        "ein": {
          "type": "string",
          "minLength": 9,
          "maxLength": 30,
          "description": "Enter either TIN or EIN as assigned by the Internal Revenue Service.  If your organization is not in the US, enter 44-4444444.  This field is required.",
          "title": "EIN/TIN"
        },
        "uei": {
          "allOf": [
            {
              "$ref": "#/$defs/organization.uei"
            }
          ],
          "description": "UEI of the applicant organization. This field is pre-populated from the Application cover sheet.",
          "title": "UEI",
          "readOnly": true
        },
        "address": {
          "$ref": "#/$defs/organization.address"
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Enter the name of primary organizational department, service, laboratory, or equivalent level within the organization which will undertake the assistance activity.",
          "title": "Department Name"
        },
        "division": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Enter the name of primary organizational division, office, or major subdivision which will undertake the assistance activity.",
          "title": "Division Name"
        },
        "type": {
          "$ref": "#/$defs/MandatoryApplicantType"
        }
      },
      "required": [
        "legal_name",
        "ein",
        "uei",
        "address",
        "type"
      ]
    },
    "MandatoryContact": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/person.name"
        },
        "title": {
          "$ref": "#/$defs/person.title"
        },
        "organizational_affiliation": {
          "allOf": [
            {
              "$ref": "#/$defs/organization.name"
            }
          ],
          "description": "Enter the legal name of the organization.",
          "title": "Organizational Affiliation"
        },
        "phone": {
          "$ref": "#/$defs/person.phone-number"
        },
        "fax": {
          "$ref": "#/$defs/person.fax-number"
        },
        "email": {
          "$ref": "#/$defs/person.email"
        }
      },
      "required": [
        "name",
        "phone",
        "email"
      ]
    },
    "MandatoryAssistanceListing": {
      "type": "object",
      "properties": {
        "number": {
          "allOf": [
            {
              "$ref": "#/$defs/opportunity.assistance-listing-number"
            }
          ],
          "description": "The assistance listing number associated with this competition.",
          "title": "Assistance Listing Number",
          "readOnly": true
        },
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/opportunity.assistance-listing-title"
            }
          ],
          "description": "The program title associated with the assistance listing.",
          "title": "Assistance Listing Title",
          "readOnly": true
        }
      }
    },
    "MandatoryOpportunity": {
      "type": "object",
      "properties": {
        "agency_name": {
          "allOf": [
            {
              "$ref": "#/$defs/opportunity.agency-name"
            }
          ],
          "description": "The federal agency providing the funding opportunity.",
          "title": "Name of Federal Agency",
          "readOnly": true
        },
        "assistance_listing": {
          "allOf": [
            {
              "$ref": "#/$defs/MandatoryAssistanceListing"
            }
          ],
          "properties": {
            "number": {
              "readOnly": true
            },
            "title": {
              "readOnly": true
            }
          }
        }
      },
      "required": [
        "agency_name"
      ]
    },
    "MandatoryProject": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250,
          "description": "Enter a descriptive title of the project. This field is required.",
          "title": "Descriptive Title of Applicant's Project"
        },
        "areas_affected": {
          "type": "string",
          "minLength": 0,
          "maxLength": 250,
          "description": "Enter areas or entities affected using categories specified in the agency instructions.",
          "title": "Areas Affected by Funding"
        }
      },
      "required": [
        "title"
      ]
    },
    "MandatoryCongressionalDistricts": {
      "type": "object",
      "properties": {
        "applicant": {
          "allOf": [
            {
              "$ref": "#/$defs/person.congressional-district"
            }
          ],
          "description": "Enter the Congressional District as a two-character state abbreviation, a hyphen and a three-digit district number (for example, CA-005). If outside the US, enter 00-000.",
          "title": "Applicant Congressional District"
        },
        "project": {
          "allOf": [
            {
              "$ref": "#/$defs/person.congressional-district"
            }
          ],
          "description": "Enter the Congressional District as a two-character state abbreviation, a hyphen and a three-digit district number (for example, CA-005). If outside the US, enter 00-000.",
          "title": "Program/Project Congressional District"
        },
        "additional_attachment": {
          "allOf": [
            {
              "$ref": "#/$defs/types.attachment"
            }
          ],
          "description": "Attach a file listing additional congressional districts.",
          "title": "Additional Congressional Districts Attachment"
        }
      },
      "required": [
        "applicant"
      ]
    },
    "MandatoryFundingAmount": {
      "type": "number",
      "minimum": 0,
      "maximum": 999999999999.99,
      "multipleOf": 0.01
    },
    "MandatoryFunding": {
      "type": "object",
      "properties": {
        "start_date": {
          "type": "string",
          "format": "date",
          "description": "Enter the start date of the funding period for this submission. Enter in the format mm/dd/yyyy. This field is required.",
          "title": "Funding Period Start Date"
        },
        "end_date": {
          "type": "string",
          "format": "date",
          "description": "Enter the end date of the funding period for this submission. Enter in the format mm/dd/yyyy. This field is required.",
          "title": "Funding Period End Date"
        },
        "estimated_federal": {
          "allOf": [
            {
              "$ref": "#/$defs/MandatoryFundingAmount"
            }
          ],
          "description": "Enter the dollar amount.  This field is required.",
          "title": "Estimated Funding - Federal"
        },
        "estimated_match": {
          "allOf": [
            {
              "$ref": "#/$defs/MandatoryFundingAmount"
            }
          ],
          "description": "Enter the dollar amount.",
          "title": "Estimated Funding - Match"
        }
      },
      "required": [
        "start_date",
        "end_date",
        "estimated_federal"
      ]
    },
    "MandatoryStateReviewStatus": {
      "type": "string",
      "enum": [
        "StateReviewAvailable",
        "StateReviewNotSelected",
        "StateReviewNotNeeded"
      ]
    },
    "MandatoryStateReview": {
      "type": "object",
      "properties": {
        "status": {
          "allOf": [
            {
              "$ref": "#/$defs/MandatoryStateReviewStatus"
            }
          ],
          "description": "Applicants should contact the State Single Point of Contact (SPOC) for Federal Executive Order 12372 to determine whether the application is subject to the State intergovernmental review process.   This field is required.",
          "title": "Is Submission Subject to Review by State Under Executive Order 12372?"
        },
        "available_date": {
          "type": "string",
          "format": "date",
          "description": "Enter the date the submission was provided to the State for review.  Enter in the format mm/dd/yyyy.",
          "title": "State Review Available Date"
        }
      },
      "required": [
        "status"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "StateReviewAvailable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "available_date"
            ]
          }
        }
      ]
    },
    "MandatoryDebt": {
      "type": "object",
      "properties": {
        "is_delinquent": {
          "type": "boolean",
          "description": "This question applies to the applicant organization, not the person who signs as the authorized representative.  This field is required.",
          "title": "Is the Applicant Delinquent on Any Federal Debt?"
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "Provide an explanation of Delinquent Federal Debt in the text box.",
          "title": "Federal Debt Delinquency Explanation"
        }
      },
      "required": [
        "is_delinquent"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "is_delinquent": {
                "const": true
              }
            },
            "required": [
              "is_delinquent"
            ]
          },
          "then": {
            "required": [
              "explanation"
            ]
          }
        }
      ]
    },
    "MandatoryCertification": {
      "type": "object",
      "properties": {
        "agree": {
          "type": "boolean",
          "const": true,
          "description": "Check to select.  This field is required.",
          "title": "Application Certification (I Agree)"
        }
      },
      "required": [
