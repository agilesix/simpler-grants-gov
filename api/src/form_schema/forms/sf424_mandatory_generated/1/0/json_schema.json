{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "submission": {
      "$ref": "#/$defs/MandatorySubmission"
    },
    "dates": {
      "allOf": [
        {
          "$ref": "#/$defs/MandatoryDates"
        }
      ],
      "properties": {
        "received_date": {
          "readOnly": true
        }
      }
    },
    "identifiers": {
      "$ref": "#/$defs/MandatoryIdentifiers"
    },
    "applicant": {
      "allOf": [
        {
          "$ref": "#/$defs/MandatoryApplicant"
        }
      ],
      "properties": {
        "uei": {
          "readOnly": true
        }
      }
    },
    "contact": {
      "$ref": "#/$defs/MandatoryContact"
    },
    "opportunity": {
      "allOf": [
        {
          "$ref": "#/$defs/MandatoryOpportunity"
        }
      ],
      "properties": {
        "agency_name": {
          "readOnly": true
        },
        "assistance_listing": {
          "properties": {
            "number": {
              "readOnly": true
            },
            "title": {
              "readOnly": true
            }
          }
        }
      }
    },
    "project": {
      "$ref": "#/$defs/MandatoryProject"
    },
    "congressional_districts": {
      "$ref": "#/$defs/MandatoryCongressionalDistricts"
    },
    "funding": {
      "$ref": "#/$defs/MandatoryFunding"
    },
    "state_review": {
      "$ref": "#/$defs/MandatoryStateReview"
    },
    "debt": {
      "$ref": "#/$defs/MandatoryDebt"
    },
    "certification": {
      "$ref": "#/$defs/MandatoryCertification"
    },
    "authorized_representative": {
      "allOf": [
        {
          "$ref": "#/$defs/MandatoryAuthorizedRepresentative"
        }
      ],
      "properties": {
        "signature": {
          "readOnly": true
        },
        "date_signed": {
          "readOnly": true
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/types.attachment"
      },
      "maxItems": 100,
      "description": "Attach supporting documents as specified in agency instructions.",
      "title": "Supporting Documents"
    }
  },
  "required": [
    "submission",
    "applicant",
    "contact",
    "opportunity",
    "project",
    "congressional_districts",
    "funding",
    "state_review",
    "debt",
    "certification",
    "authorized_representative"
  ],
  "examples": [
    {
