              "label": "Degree Year"
            }
          ],
          "label": "Credentials",
          "options": {
            "description": "Enter the PD/PI's agency credential, if they have one, and their highest degree."
          }
        },
        {
          "type": "Group",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/principal_investigator/properties/profile/properties/biographical_sketch",
              "label": "Biographical Sketch",
              "options": {
                "widget": "Attachment"
