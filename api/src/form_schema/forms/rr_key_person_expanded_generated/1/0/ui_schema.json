              "type": "Control",
              "scope": "#/properties/principal_investigator/properties/profile/properties/address/properties/province",
              "label": "Province",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/principal_investigator/properties/profile/properties/address/properties/country",
                  "schema": {
                    "allOf": [
                      {
                        "not": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "const": ""
                            },
                            {
                              "type": "array",
                              "maxItems": 0
                            }
                          ]
                        }
                      },
                      {
                        "not": {
                          "const": "USA: UNITED STATES"
                        }
                      }
                    ]
                  },
                  "failWhenUndefined": true
